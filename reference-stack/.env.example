# Copy to .env and fill in. NEVER commit .env.
# Store the real values in your password manager; this file documents names only.

# --- Versions (pin these in production) ---
N8N_VERSION=
OLLAMA_VERSION=
CLOUDFLARED_VERSION=

# --- Hostnames ---
# Hostname used for admin access over the zero-trust connection
N8N_ADMIN_HOST=n8n.internal.example
# Public hostname routed through the Cloudflare tunnel (webhooks only)
WEBHOOK_PUBLIC_HOST=hooks.example.com

# --- n8n ---
# Generate once (for example: openssl rand -hex 32) and back it up securely.
# Losing it makes every stored n8n credential unreadable.
N8N_ENCRYPTION_KEY=

TZ=America/Los_Angeles

# --- Cloudflare tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Zero-trust connector (Twingate) ---
TWINGATE_NETWORK=
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=
